# Vercel Postgres / Neon PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_portal?schema=public"

# Direct connection (used by Prisma migrations with Neon / Vercel Postgres)
# POSTGRES_URL_NON_POOLING="postgresql://..."

# NextAuth Secret (Generate via `openssl rand -base64 32`)
AUTH_SECRET="super-secret-key-college-hackathon-2026"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob Storage Token (retrieved from Vercel Dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=""

# Next.js Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
